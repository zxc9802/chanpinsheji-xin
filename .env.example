# ── 图片模型（fal.ai）──
FAL_KEY=your-fal-key
IMAGE_MODEL=openai/gpt-image-2.5/sunburst/edit

# ── 文案解析模型（OpenAI 兼容接口）──
LLM_API_KEY=your-llm-key
LLM_BASE_URL=https://api.openlux.ai/v1/chat/completions
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=deepseek-v4.1-flash

PORT=3789

# ── 设计参考库匹配（同一份美妆研究库）──
JEV_BASE_URL=https://api.openlux.ai/v1/systemone
JEV_MODEL=jev-1.13.0
JEV_API_KEY=your-jev-key
# 可选：研究库根目录；默认读取项目内自带的研究库
# REFERENCE_LIBRARY_ROOT=/absolute/path/to/beauty-design-2026-09-28

# ── Claude 规划模式（可选；不配置时只能用参考库模式）──
CLAUDE_PLAN_URL=https://api.openlux.ai/v1/messages
CLAUDE_PLAN_MODEL=claude-opus-5-5
CLAUDE_PLAN_KEY=your-claude-key
